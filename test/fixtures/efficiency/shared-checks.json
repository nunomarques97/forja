{
  "name": "shared-checks",
  "description": "Scenarios only: four sequential tasks that each run their own check plus the two project-wide checks every task repeats (like npm test and a check script); measures check executions, including the final regression.",
  "packets": false,
  "goal": "Implement the four unit converters in src/ so each returns the converted value, keeping every module exported by name and the project suite and lint green after each task.",
  "files": {
    "package.json": "{\n  \"name\": \"bench-shared\",\n  \"private\": true,\n  \"type\": \"module\"\n}\n",
    "AGENTS.md": "# Agent notes\n\nUse Node 24 built-ins only. Every task keeps scripts/suite.mjs and scripts/lint.mjs green.\n",
    "src/length.mjs": "export function metres(feet) {\n  return feet;\n}\n",
    "src/mass.mjs": "export function kilograms(pounds) {\n  return pounds;\n}\n",
    "src/volume.mjs": "export function litres(gallons) {\n  return gallons;\n}\n",
    "src/heat.mjs": "export function celsius(fahrenheit) {\n  return fahrenheit;\n}\n",
    "scripts/suite.mjs": "import { metres } from '../src/length.mjs';\nimport { kilograms } from '../src/mass.mjs';\nimport { litres } from '../src/volume.mjs';\nimport { celsius } from '../src/heat.mjs';\nfor (const fn of [metres, kilograms, litres, celsius]) if (typeof fn !== 'function' || Number.isNaN(fn(1))) process.exit(1);\n",
    "scripts/lint.mjs": "import { readdirSync, readFileSync } from 'node:fs';\nfor (const file of readdirSync('src')) if (/\\bvar\\b|\\t/.test(readFileSync(`src/${file}`, 'utf8'))) process.exit(1);\n"
  },
  "plan": {
    "decisions": ["Each converter is one pure function; the suite and lint scripts are the project-wide checks of every task."],
    "tasks": [
      {
        "id": "T1", "title": "Convert feet to metres", "criteria": ["metres(1) is 0.3048"],
        "files": ["src/length.mjs"], "risks": [], "complexity": "easy", "after": [],
        "checks": [
          { "command": "node", "args": ["--input-type=module", "-e", "import {metres} from './src/length.mjs'; if (metres(1) !== 0.3048) process.exit(1)"] },
          { "command": "node", "args": ["scripts/suite.mjs"] },
          { "command": "node", "args": ["scripts/lint.mjs"] }
        ],
        "solution": { "src/length.mjs": "export function metres(feet) {\n  return feet * 0.3048;\n}\n" }
      },
      {
        "id": "T2", "title": "Convert pounds to kilograms", "criteria": ["kilograms(1) is 0.45359237"],
        "files": ["src/mass.mjs"], "risks": [], "complexity": "easy", "after": ["T1"],
        "checks": [
          { "command": "node", "args": ["--input-type=module", "-e", "import {kilograms} from './src/mass.mjs'; if (kilograms(1) !== 0.45359237) process.exit(1)"] },
          { "command": "node", "args": ["scripts/suite.mjs"] },
          { "command": "node", "args": ["scripts/lint.mjs"] }
        ],
        "solution": { "src/mass.mjs": "export function kilograms(pounds) {\n  return pounds * 0.45359237;\n}\n" }
      },
      {
        "id": "T3", "title": "Convert US gallons to litres", "criteria": ["litres(1) is 3.785411784"],
        "files": ["src/volume.mjs"], "risks": [], "complexity": "easy", "after": ["T2"],
        "checks": [
          { "command": "node", "args": ["--input-type=module", "-e", "import {litres} from './src/volume.mjs'; if (litres(1) !== 3.785411784) process.exit(1)"] },
          { "command": "node", "args": ["scripts/suite.mjs"] },
          { "command": "node", "args": ["scripts/lint.mjs"] }
        ],
        "solution": { "src/volume.mjs": "export function litres(gallons) {\n  return gallons * 3.785411784;\n}\n" }
      },
      {
        "id": "T4", "title": "Convert Fahrenheit to Celsius", "criteria": ["celsius(212) is 100"],
        "files": ["src/heat.mjs"], "risks": [], "complexity": "easy", "after": ["T3"],
        "checks": [
          { "command": "node", "args": ["--input-type=module", "-e", "import {celsius} from './src/heat.mjs'; if (celsius(212) !== 100) process.exit(1)"] },
          { "command": "node", "args": ["scripts/suite.mjs"] },
          { "command": "node", "args": ["scripts/lint.mjs"] }
        ],
        "solution": { "src/heat.mjs": "export function celsius(fahrenheit) {\n  return (fahrenheit - 32) * 5 / 9;\n}\n" }
      }
    ]
  },
  "scenarios": ["happy", "check_fail_once"]
}

{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "fallbackModel": ["opus"],
  "hooks": {
    "SessionStart":       [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "UserPromptSubmit":   [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "PreToolUse":         [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "PostToolUse":        [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "PostToolUseFailure": [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "PermissionRequest":  [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "PermissionDenied":   [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "Notification":       [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "SubagentStart":      [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "SubagentStop":       [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "Stop":               [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "StopFailure":        [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "PreCompact":         [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "PostCompact":        [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "PreModelSwitch":     [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "PostModelSwitch":    [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 10 } ] } ],
    "SessionEnd":         [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/log-event.mjs\"", "timeout": 5 } ] } ]
  }
}
